{
  "name": "ecole-saas-cameroun",
  "version": "1.1.6",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron-dev": "electron .",
    "electron-pack": "next build --webpack && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/nextjs": "^10.65.0",
    "@serwist/next": "^9.5.11",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "electron-updater": "^6.8.9",
    "idb-keyval": "^6.2.5",
    "next": "16.2.7",
    "openai": "^7.10.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "serwist": "^9.5.11",
    "sql.js": "^1.14.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.41",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sql.js": "^1.4.11",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.mboaschool.app",
    "productName": "MboaSchool",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "**/@next/swc-*/**"
    ],
    "directories": {
      "output": "release-dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next",
        "to": "nextapp/.next",
        "filter": [
          "**/*",
          "!cache/**",
          "!dev/**"
        ]
      },
      {
        "from": "public",
        "to": "nextapp/public"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "anorps1-png",
        "repo": "MboaSchool",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "differentialPackage": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
